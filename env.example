# ============================================================
# FlexiChrono 环境变量配置模板
# 复制为 .env 或在云端平台（Railway等）环境变量页面配置
# ============================================================

# ---------- 数据目录（必填）----------
# Docker/Railway 部署时设为 /data（需挂载 Volume），本地开发可留空（默认脚本所在目录）
DATA_DIR=/data

# ---------- 各服务端口（一般不用改，launcher.py 会自动注入）----------
# 注意：不要使用通用的 PORT 环境变量，云端平台会注入 PORT=8080 导致端口冲突
MAIN_PORT=8000
VECTOR_PORT=8001
PERSONALITY_PORT=8002
PROACTIVE_PORT=8003
VOICE_PORT=8004

# ---------- 必填：豆包大模型（火山方舟）----------
# 人格后端 LLM 对话 + 记忆后端 Embedding 都依赖它
# P1 多模型路由：豆包为1级主力模型，连续失败3次自动降级到2级
DOUBAO_API_KEY=你的豆包APIKey
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 豆包推理接入点 Endpoint ID（在火山方舟控制台创建推理接入点后获取）
DOUBAO_MODEL=你的endpoint_id

# ---------- P1：多模型智能降级配置（可选，不配置则只用豆包）----------
# 降级规则：豆包(1级) → Kimi/DeepSeek(2级轮流) → 千问(3级)
# 连续失败几次后降级（默认3）
LLM_FAIL_THRESHOLD=3
# 降级后多少秒探测一次，成功则恢复（默认60秒）
LLM_RECOVER_INTERVAL=60
# 单次请求超时（秒，默认60）
LLM_REQUEST_TIMEOUT=60
# 单个模型内部重试次数（默认2）
LLM_MAX_RETRIES=2

# ---- 2级：DeepSeek（火山方舟接入，和豆包同一个API Key，不同Model ID）----
# 在火山方舟控制台创建 DeepSeek 模型的推理接入点，填入 Endpoint ID
# API Key 和 Base URL 默认和豆包共用，如需单独配置可取消注释
# DEEPSEEK_VOLC_API_KEY=你的豆包APIKey
# DEEPSEEK_VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_VOLC_MODEL=你的deepseek_endpoint_id

# ---- 3级：千问（火山方舟接入，和豆包同一个API Key，不同Model ID）----
# 在火山方舟控制台创建 千问/Qwen 模型的推理接入点，填入 Endpoint ID
# API Key 和 Base URL 默认和豆包共用，如需单独配置可取消注释
# QWEN_VOLC_API_KEY=你的豆包APIKey
# QWEN_VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
QWEN_VOLC_MODEL=你的qwen_endpoint_id

# ---- 备选：DeepSeek 官方 API（不参与自动降级，手动启用）----
# 你已有 DeepSeek 官方 API Key 但未启用，留作备用
# 如需启用为2级模型，将 DEEPSEEK_OFFICIAL_ENABLED 设为 true
DEEPSEEK_OFFICIAL_ENABLED=false
# DEEPSEEK_OFFICIAL_API_KEY=你的DeepSeek官方Key
# DEEPSEEK_OFFICIAL_BASE_URL=https://api.deepseek.com
# DEEPSEEK_OFFICIAL_MODEL=deepseek-chat

# ---------- Embedding 模型（豆包多模态，记忆向量化用）----------
DOUBAO_EMBEDDING_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
DOUBAO_EMBEDDING_MODEL=你的embedding_endpoint_id

# ---------- 必填：NapCat QQ 回复 ----------
# NapCat OneBot v11 HTTP API 地址（用于主动发QQ消息）
# 如果 NapCat 和容器在同一主机，填宿主机地址（不要用127.0.0.1，那是容器内部）
NAPCAT_HTTP_URL=http://你的宿主机IP:3000
# NapCat HTTP API 访问令牌（NapCat 配置中的 access_token，没配置则留空）
NAPCAT_ACCESS_TOKEN=
# QQ Webhook 签名校验密钥（NapCat 配置中的 secret，留空则不校验）
QQ_WEBHOOK_SECRET=

# ---------- 可选：DashVector 向量检索 ----------
# 不配置则降级为伪向量模式（能跑但记忆检索质量差）
DASHVECTOR_API_KEY=你的DashVectorKey
DASHVECTOR_ENDPOINT=https://vrs-xxx.dashvector.cn-beijing.aliyuncs.com
DASHVECTOR_COLLECTION=flexichrono

# ---------- 可选：DeepSeek 记忆摘要 ----------
# 不配置则记忆分析功能不可用（不影响基础对话）
DEEPSEEK_API_KEY=你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 可选：Kimi 联网搜索 + 2级降级模型 ----------
# P1 多模型路由：Kimi 同时作为2级降级模型（和DeepSeek同级轮流）
# 联网搜索使用 KIMI_SEARCH_MODEL，对话降级使用 KIMI_MODEL
KIMI_API_KEY=你的KimiKey
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_SEARCH_MODEL=moonshot-v1-search

# ---------- 可选：语音识别 ASR（SiliconFlow SenseVoice）----------
ASR_API_KEY=你的SiliconFlowKey
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_LANGUAGE=zh

# ---------- 可选：TTS 语音合成 ----------
# 默认使用免费 edge-tts，无需配置；如需 OpenAI 兼容 TTS 则填写：
TTS_ENGINE=edge-tts
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_FORMAT=wav

# ---------- LLM 心理状态校准（可选，默认启用）----------
LLM_CALIBRATION_ENABLED=true
LLM_CALIBRATION_MODEL=doubao-seed-2.0-mini

# ---------- 内部安全 Token（建议修改默认值，5个服务保持一致）----------
VECTOR_API_TOKEN=change_me_strong_secret_key_123456
INTERNAL_TOKEN=change_me_internal_secret_2026

# ---------- CORS 跨域（一般不用改）----------
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# ---------- P1 模块3：图像生成/自拍（豆包 Seedream，火山方舟）----------
# 不配置则图像生成功能不可用（不影响基础对话）
# Seedream API Key 默认和豆包LLM共用，如需单独配置可取消注释
# SEEDREAM_API_KEY=你的豆包APIKey
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Seedream 推理接入点 Endpoint ID（在火山方舟控制台创建 Seedream 模型接入点后获取）
SEEDREAM_MODEL=你的seedream_endpoint_id

# 频率限制（可自由调整）
# 每用户每小时最多生成多少张自拍（防止API被滥用）
MAX_USER_IMAGES_PER_HOUR=5
# 每角色每天最多主动发多少张图
MAX_PROACTIVE_IMAGES_PER_DAY=2

# 图片尺寸
# 自拍尺寸（3:4竖版，适合人像自拍）
SELFIE_SIZE=768x1024
# 风景/其他尺寸（4:3横版）
LANDSCAPE_SIZE=1024x768

# ---------- P3 模块1：NapCat 群聊多角色 + 图片理解 + 主动发图 ----------
# 群聊配置文件路径（群聊角色QQ映射、触发模式等，默认在DATA_DIR下）
# GROUP_CONFIG_PATH=/data/group_config.json

# 主动联系时自动发图（自拍）
# 启用后，proactive_server 主动联系用户时，会自动生成一张角色自拍图片一起发到QQ
# 注意：需要先配置 SEEDREAM_MODEL 图像生成才能生效
PROACTIVE_AUTO_IMAGE=false
# 主动发图的亲密度阈值（低于此值不发图，避免陌生人主动发自拍）
PROACTIVE_IMAGE_INTIMACY_THRESHOLD=50

# 图片理解（豆包多模态视觉模型）
# 用户在QQ/网页端发图片给角色时，角色能"看到"图片内容并回复
# 不配置则图片理解功能不可用（图片消息会被忽略）
# API Key 默认和豆包LLM共用，如需单独配置可取消注释
# DOUBAO_VISION_API_KEY=你的豆包APIKey
# DOUBAO_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 豆包视觉模型 Endpoint ID（在火山方舟控制台创建 doubao-vision 模型接入点后获取）
DOUBAO_VISION_MODEL=你的vision_endpoint_id
