# ============================================================
# FlexiChrono 环境变量配置模板
# 复制为 .env 或在云端平台环境变量页面配置
# ============================================================

# ---------- 必填：豆包大模型 ----------
# 人格后端 LLM 对话 + 记忆后端 Embedding 都依赖它
DOUBAO_API_KEY=你的豆包APIKey
# 豆包推理接入点 Endpoint ID（在火山方舟控制台创建推理接入点后获取）
DOUBAO_MODEL=你的endpoint_id

# ---------- 必填：NapCat QQ 回复 ----------
# NapCat OneBot v11 HTTP API 地址（用于主动发QQ消息）
# 如果 NapCat 和容器在同一主机，填宿主机地址（不要用127.0.0.1，那是容器内部）
NAPCAT_HTTP_URL=http://你的宿主机IP:3000

# ---------- 可选：DashVector 向量检索 ----------
# 不配置则降级为伪向量模式（能跑但记忆检索质量差）
DASHVECTOR_API_KEY=你的DashVectorKey
# DASHVECTOR_ENDPOINT=https://vrs-xxx.dashvector.cn-beijing.aliyuncs.com

# ---------- 可选：DeepSeek 记忆摘要 ----------
# 不配置则记忆分析功能不可用（不影响基础对话）
DEEPSEEK_API_KEY=你的DeepSeekKey

# ---------- 可选：Kimi 联网搜索（A线知识路由）----------
KIMI_API_KEY=你的KimiKey

# ---------- 可选：语音识别 ASR ----------
ASR_API_KEY=你的SiliconFlowKey
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ---------- 可选：TTS 语音合成 ----------
# 默认使用免费 edge-tts，无需配置；如需 OpenAI 兼容 TTS 则填写：
# TTS_ENGINE=openai
# TTS_API_KEY=
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=tts-1

# ---------- 内部安全 Token（建议修改默认值）----------
VECTOR_API_TOKEN=change_me_strong_secret_key_123456
INTERNAL_TOKEN=change_me_internal_secret_2026

# ---------- QQ Webhook 签名校验（NapCat secret，留空不校验）----------
QQ_WEBHOOK_SECRET=
