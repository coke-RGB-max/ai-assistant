# ============================================================
# FlexiChrono 环境变量模板
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# ============================================================

# ---- NapCat QQ ----
# NapCat OneBot v11 HTTP API 地址（用于发送 QQ 消息）
# 本地: http://127.0.0.1:3000
# Docker 内访问宿主机: http://host.docker.internal:3000
NAPCAT_HTTP_URL=http://127.0.0.1:3000
# Webhook 签名密钥（NapCat 配置中的 secret，留空不校验）
QQ_WEBHOOK_SECRET=

# ---- 豆包 LLM（人格后端）----
# 获取地址: https://console.volcengine.com/ark
DOUBAO_API_KEY=sk-your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-your-endpoint-id

# ---- 豆包 Embedding（记忆后端）----
DOUBAO_EMBEDDING_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
DOUBAO_EMBEDDING_MODEL=ep-your-embedding-endpoint-id

# ---- Kimi 联网搜索（人格后端知识路由 A 线）----
# 获取地址: https://platform.moonshot.cn/
KIMI_API_KEY=sk-your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_SEARCH_MODEL=moonshot-v1-search

# ---- DashVector 阿里云向量数据库（记忆后端）----
# 获取地址: https://dashvector.console.aliyun.com/
# 不配置则降级为伪向量模式（不推荐生产使用）
DASHVECTOR_API_KEY=
DASHVECTOR_ENDPOINT=https://your-cluster.dashvector.cn-beijing.aliyuncs.com
DASHVECTOR_COLLECTION=flexichrono

# ---- DeepSeek 记忆摘要（记忆后端）----
# 获取地址: https://platform.deepseek.com/
# 不配置则记忆摘要功能不可用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- SiliconFlow 语音 ASR（语音后端）----
# 获取地址: https://cloud.siliconflow.cn/
ASR_API_KEY=sk-your-siliconflow-api-key
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_LANGUAGE=zh

# ---- TTS 语音合成 ----
# 引擎: edge-tts（免费，无需 API Key）或 openai
TTS_ENGINE=edge-tts
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ---- 内部通信 Token（请修改为随机字符串）----
INTERNAL_TOKEN=change_me_to_a_random_string
VECTOR_API_TOKEN=change_me_to_another_random_string

# ---- 数据目录 ----
DATA_DIR=./data

# ---- 内部服务地址（一般不需要改）----
PERSONALITY_SERVER_URL=http://127.0.0.1:8002
VECTOR_SERVER_URL=http://127.0.0.1:8001
PROACTIVE_SERVER_URL=http://127.0.0.1:8003
VOICE_SERVER_URL=http://127.0.0.1:8004
MAIN_SERVER_URL=http://127.0.0.1:8000
